+/* Einstellungen – Premium-Umbau (PLAN 2.9 und 4) */
 /* ============================================================
-   Schach-Arena · Einstellungen (Premium-Umbau, Look A)
-   Angelegt von U1 (leer), gefuellt von Paket U8 (PLAN 2.9).
-   Nur Tokens benutzen (css/tokens.css, css/themes/<id>.css), keine festen Farben.
+   EINSTELLUNGEN
    ============================================================ */
+.es-inhalt { width: 100%; max-width: 760px; margin: 0 auto; padding: 0 18px 36px; display: flex; flex-direction: column; gap: 14px; }
+.es-gruppe { padding: 14px 16px; }
+.es-titel { margin: 2px 0 8px; padding-left: 0; font-size: var(--fs-ueber); font-weight: var(--gw-stark); letter-spacing: var(--lw-ueber);
+  text-transform: uppercase; color: var(--text-2); }
+.es-hilfe { margin: 0 0 12px; font-size: 14px; color: var(--text-2); }
+.es-zeile { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 10px; min-height: 64px; padding: 6px 0;
+  border-bottom: 1px solid var(--linie); }
+.es-zeile:last-child { border-bottom: 0; }
+.es-text { min-width: 0; cursor: pointer; }
+.es-text b { display: block; font-size: 16px; font-weight: 750; }
+.es-text span { display: block; font-size: 13px; color: var(--text-2); margin-top: 1px; }
+.es-schalter { width: 68px; height: 48px; padding: 0; border: 0; background: none; display: grid; place-items: center; cursor: pointer; border-radius: 14px; }
+.es-schalter i { position: relative; width: 54px; height: 32px; border-radius: 999px; background: var(--flaeche-3); border: 1px solid var(--linie-2);
+  transition: background .2s ease, box-shadow .2s ease; }
+.es-schalter i::after { content: ""; position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%; background: #FFFFFF;
+  box-shadow: 0 1px 3px rgba(0, 0, 0, .25), 0 0 0 .5px rgba(0, 0, 0, .06); transition: transform .2s cubic-bezier(.2, .9, .3, 1.2), background .2s; }
+.es-schalter[aria-checked="true"] i { background: var(--schalter-an); border-color: transparent; }
+.es-schalter[aria-checked="true"] i::after { transform: translateX(22px); background: var(--knauf-an); }
+.es-probe.knopf { min-height: 44px; padding: 0 14px; font-size: 14px; background: var(--flaeche-2); box-shadow: none; }
