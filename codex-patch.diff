+  .an-screen *, .an-screen *::before, .an-screen *::after,
+  .vl-screen *, .vl-screen *::before, .vl-screen *::after,
+  .es-screen *, .es-screen *::before, .es-screen *::after {
+    animation-duration: .01ms !important; animation-iteration-count: 1 !important; animation-delay: 0s !important; transition-duration: .01ms !important; }
+}
+
+
+/* Zweispaltige iPad-Navigation; auf dem Handy bleibt nur der Inhalt. */
+.es-layout { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 18px 36px; display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 18px; align-items: start; }
+.es-layout .es-inhalt { width: auto; max-width: none; margin: 0; padding: 0; }
+.es-nav { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 4px; padding: 8px; border: 1px solid var(--linie); border-radius: var(--r-m); background: var(--flaeche); box-shadow: var(--s1); }
