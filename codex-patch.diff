+.an-phasen { position: relative; height: 20px; margin-top: 2px; }
+.an-phasen span { position: absolute; top: 2px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding: 0 4px;
+  font-size: 11px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; color: var(--text-2); text-align: center; }
+
+/* ---------- Schluesselmomente ---------- */
+.an-momente-titel { margin: 0 0 6px 2px; font-size: var(--fs-ueber); font-weight: var(--gw-stark); letter-spacing: var(--lw-ueber); text-transform: uppercase; color: var(--text-2); }
+.an-momente { display: flex; gap: 8px; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; padding: 2px;
+  -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent); mask-image: linear-gradient(90deg, #000 88%, transparent); }
+.an-momente::-webkit-scrollbar { display: none; }
+.an-momente::after { content: ""; flex: 0 0 28px; }
+.an-moment.knopf { flex: none; min-height: 44px; padding: 0 12px; font-size: 14px; gap: 6px; background: var(--flaeche); }
+.an-moment.knopf svg { width: 18px; height: 18px; }
+.an-moment:not(.du) { color: var(--text-2); font-weight: 600; }
+.an-moment.an { box-shadow: inset 0 0 0 1.5px var(--text); background: var(--flaeche-3); color: var(--text); }
+.an-momente-leer { font-size: 14px; color: var(--text-2); padding: 4px 2px; -webkit-mask-image: none; mask-image: none; }
+
+/* ---------- Klassen-Zaehler ---------- */
+.an-klassen { padding: 8px 16px 6px; }
+.an-kl-raster { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: repeat(7, auto) auto; grid-auto-flow: column; column-gap: 18px; }
+.an-kl-kopf { display: flex; justify-content: space-between; align-items: center; gap: 8px; height: 24px; font-size: 11px; font-weight: 750; letter-spacing: .1em;
+  text-transform: uppercase; color: var(--text-2); }
+.an-kl-kopf span:first-child { flex: none; width: 34px; text-align: center; }
+.an-kl-kopf span:last-child { min-width: 34px; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: .06em; }
+.an-kl { display: grid; grid-template-columns: 34px minmax(0, 1fr) 34px; align-items: center; width: 100%; min-height: 44px; padding: 0; margin: 0;
+  background: none; border: 0; border-bottom: 1px solid var(--linie); border-radius: 0; color: inherit; font: inherit; text-align: left; cursor: pointer; }
+.an-kl:active:not(.leer) { background: var(--flaeche-2); }
+.an-kl.leer { cursor: default; }
+.an-n { font-weight: 850; font-size: 16px; text-align: center; font-variant-numeric: tabular-nums; }
+.an-n.du { color: var(--kt, var(--text)); }
+.an-n.nul { color: var(--text-3); }
+.an-kl-mitte { display: flex; align-items: center; gap: 8px; min-width: 0; font-size: 14px; font-weight: 650; }
+.an-kl-mitte span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
+.an-kl-mitte svg { width: 22px; height: 22px; flex: none; }
+.an-kl.null .an-kl-mitte { opacity: .45; }
+.an-kl-gesamt { grid-column: 1 / -1; grid-row: 8; cursor: default; border-bottom: 0; border-top: 1px solid var(--linie-2); min-height: 40px;
+  grid-template-columns: 34px minmax(0, 1fr) 34px; }
+.an-kl-gesamt .an-kl-mitte { justify-content: center; font-size: 13px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; color: var(--text-2); }
+.an-kl-platz { border-bottom: 1px solid var(--linie); }
+
+/* ---------- Kopf-Knoepfe unten (Handy) ---------- */
+.an-aktionsleiste { display: none; }
+
+/* ---------- Laden / Fehler / unbekannte Partie ---------- */
+.an-laden, .an-meldung { width: min(520px, calc(100% - 36px)); margin: 6vh auto 24px; padding: 26px 24px; display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
+.an-laden-duell { display: flex; align-items: center; gap: 16px; }
+.an-laden-duell .an-avatar { --g: 72px; }
+.an-laden-vs { font-size: 12px; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; color: var(--text-2); }
+.an-laden-titel, .an-meldung h3 { margin: 0; font-family: var(--display); font-size: 21px; font-weight: var(--gw-titel); letter-spacing: -.02em; }
+.an-fortschritt { position: relative; width: 100%; height: 12px; border-radius: 999px; overflow: hidden; background: var(--flaeche-3); border: 1px solid var(--linie); }
+.an-fortschritt i { position: absolute; left: 0; top: 0; bottom: 0; width: var(--wert, 0%); border-radius: inherit; background: var(--tinte);
+  transition: width .3s ease; }
+.an-fortschritt i::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .3), transparent);
+  background-size: 60px 100%; background-repeat: no-repeat; animation: an-glanz 1.3s linear infinite; }
+@keyframes an-glanz { from { background-position: -60px 0; } to { background-position: 520px 0; } }
+.an-laden-text, .an-meldung p { margin: 0; font-size: 14px; color: var(--text-2); }
+.an-laden.fehler .an-laden-titel { color: var(--warn); }
+.an-meldung-icon { width: 64px; height: 64px; display: grid; place-items: center; border-radius: 50%; background: var(--flaeche-2); color: var(--text); border: 1.5px solid var(--linie-2); }
+.an-meldung-icon svg { width: 32px; height: 32px; }
+
+/* ---------- Niedriges Querformat (Handy quer): Brett nach der Hoehe, linke Spalte scrollt ---------- */
+@media (orientation: landscape) and (max-height: 560px) {
+  .an-screen { --tap: 44px;
+    --an-brett: min(calc(100vh - 56px - 12px - 8px - var(--an-sicher)), calc(100vw - 20px - 20px - 34px - 300px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)));
+    --an-brett: min(calc(100dvh - 56px - 12px - 8px - var(--an-sicher)), calc(100vw - 20px - 20px - 34px - 300px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px))); }
+  .an-screen .kopf { height: 56px; padding: 0 10px; }
+  .an-inhalt { padding: 0 10px 12px; gap: 16px; }
+  .an-kopf-knoepfe .knopf { padding: 0 12px; font-size: 14px; }
+}
+
+/* ---------- Hochformat (iPad hoch, Handy): eine Spalte, die Seite scrollt ---------- */
+@media (orientation: portrait) {
+  .an-screen { --an-brett: min(calc(100vw - 36px - 34px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)), 720px); }
+  .an-koerper { flex: none; display: block; }
+  .an-inhalt { display: flex; flex-direction: column; gap: 12px; width: calc(var(--an-brett) + 8px + var(--an-balken)); max-width: 100%; padding: 0 0 18px; }
+  .an-links, .an-rechts { display: contents; }
+  .an-banner { order: 1; } .an-genau { order: 2; } .an-kurve-box { order: 3; }
+  .an-brettzone { order: 4; } .an-navi { order: 5; } .an-coach { order: 6; }
+  .an-momente-box, .an-momente-leer { order: 7; } .an-klassen { order: 8; }
+  .an-screen.ohne-balken { --an-brett: min(calc(100vw - 36px - 8px), 720px); }
+}
+@media (orientation: portrait) and (max-width: 520px) {
+  .an-screen { --tap: 44px; --an-balken: 20px; --an-brett: calc(100vw - 20px - 6px - 20px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)); }
+  .an-screen.ohne-balken { --an-brett: calc(100vw - 20px - 6px); }
+  .an-screen .kopf { height: 56px; padding: 0 10px; }
+  .an-kopf-knoepfe { display: none; }
+  .an-inhalt { gap: 10px; padding-bottom: 6px; }
+  .an-brettzone { gap: 6px; }
+  .an-evalbalken { width: 14px; }
+  .an-brett-rahmen { width: calc(var(--an-brett) + 6px); padding: 3px; border-radius: 14px; }
+  .an-brett-rahmen::after { inset: 2px; border-radius: 12px; }
+  .an-brett-rahmen .brett { --brett-radius: 11px; }
+  .an-navi { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+  .an-stand { display: none; }
+  .an-banner { padding: 10px 12px; gap: 10px; }
+  .an-banner .an-avatar { --g: 44px; }
+  .an-ft-titel { font-size: 10px; letter-spacing: .08em; }
+  .an-ft-name { font-size: 15px; }
+  .an-ft-sterne span { display: none; }
+  .an-ft-sterne b { font-size: 20px; margin: 0; }
+  .an-genau { padding: 12px; gap: 8px 6px; }
+  .an-genau .an-avatar { --g: 36px; border-radius: 11px; }
+  .an-seite { gap: 8px; }
+  .an-g-wert { font-size: 27px; }
+  .an-g-label { font-size: 11px; }
+  .an-vs { min-width: 52px; }
+  .an-vs b { font-size: 18px; }
+  .an-vs-wort { font-size: 10px; letter-spacing: .1em; }
+  .an-vs-grund { font-size: 11px; max-width: 84px; }
+  .an-kurve-wrap { height: 92px; }
+  .an-k-legende { display: none; }
+  .an-g-zusatz { display: none; }
+  .an-c-fuss { flex-wrap: wrap; }
+  .an-c-linie { flex-basis: 100%; }
+  .an-coach { padding: 10px 12px; gap: 2px 10px; }
+  .an-c-symbol { width: 38px; height: 38px; }
+  .an-c-klasse { font-size: 17px; }
+  .an-c-zug { font-size: 15px; }
+  .an-c-text { font-size: 14px; }
+  .an-c-linie { font-size: 13px; }
+  .an-klassen { padding: 6px 12px; }
+  .an-kl-raster { display: flex; flex-direction: column; }
+  .an-kl-kopf2, .an-kl-platz { display: none; }
+  .an-aktionsleiste { order: 99; display: grid; grid-template-columns: auto 1fr; gap: 8px; position: sticky; bottom: 0; z-index: 20;
+    padding: 12px 10px calc(10px + env(safe-area-inset-bottom, 0px)); margin-top: auto;
+    background: linear-gradient(var(--grund-0), var(--grund) 34%); }
+  .an-aktionsleiste .knopf { min-height: 50px; }
+  .an-laden, .an-meldung { width: calc(100% - 20px); padding: 22px 16px; }
+}
+
+/* ============================================================
+   BAU C (Integration): Die Coach-Karte der Analyse passte im
+   Querformat mit Hauptvariante oft nicht ganz unter das Brett und
+   wurde am unteren Rand abgeschnitten. Etwas mehr Platz einplanen,
+   bei sehr langem Text schrumpft die Karte und scrollt innen.
+   Zuege nicht am Bindestrich umbrechen (0-0, 0-0-0).
+   ============================================================ */
+.an-c-zuege span { white-space: nowrap; }
+@media (orientation: landscape) and (min-height: 561px) {
+  .an-screen {
+    --an-brett: min(calc(100vh - 336px - var(--an-sicher)), calc(100vw - 36px - 20px - 34px - 420px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)), 700px);
+    --an-brett: min(calc(100dvh - 336px - var(--an-sicher)), calc(100vw - 36px - 20px - 34px - 420px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)), 700px);
+  }
+  .an-navi .knopf { min-height: 48px; }
+  .an-coach { flex: 0 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 12px 14px; }
+}
diff --git a/css/einstellungen.css b/css/einstellungen.css
index 65bfcae3c0c0e55383696db4a73c411f3b5a38de..3452da9ae8074d4d8b282eaf4b4e30c379232af8 100644
