+.es-regler { display: block; padding: 12px 0; }
+.es-regler > span { display: flex; justify-content: space-between; margin-bottom: 8px; }
+.es-regler output { color: var(--text-2); font-variant-numeric: tabular-nums; }
+.es-regler input { width: 100%; min-height: 44px; accent-color: var(--akzent); }
+.es-tempo-vorschau { height: 54px; overflow: hidden; border-radius: 12px; background: var(--flaeche-2); }
+.es-tempo-vorschau span { display: block; width: 44px; font-size: 36px; animation: es-springer calc(2s * var(--tempo, 1)) var(--gleiten) infinite alternate; }
+@keyframes es-springer { to { transform: translateX(min(520px, calc(100vw - 120px))); } }
+.es-coach-vorschau { margin-top: 14px; padding: 14px; border-left: 4px solid var(--akzent); border-radius: 12px; background: var(--flaeche-2); }
+.es-coach-vorschau p { margin: 4px 0 0; color: var(--text-2); }
+@media (max-width: 700px) {
+  .es-layout { display: block; padding: 0 10px 28px; }
+  .es-nav { display: none; }
+  .es-layout .es-inhalt { padding: 0; }
+}
