+.es-brett-name { font-size: 15px; font-weight: 800; }
+.es-brett[aria-checked="true"] .es-brett-name { color: var(--text); }
+
+.es-segment { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; padding: 4px; border-radius: 16px; background: var(--grund-2); border: 1px solid var(--linie); }
+.es-seg { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; min-height: 58px; padding: 4px; border: 0; border-radius: 12px;
+  background: none; color: inherit; font: inherit; cursor: pointer; }
+.es-seg b { font-size: 15px; font-weight: 800; }
+.es-seg { color: var(--text-2); }
+.es-seg span { font-size: 12px; color: var(--text-2); }
+.es-seg[aria-checked="true"] { background: var(--flaeche); color: var(--text); box-shadow: 0 1px 2px rgba(0, 0, 0, .08), 0 2px 6px -1px rgba(0, 0, 0, .08), var(--kante); }
+.es-seg[aria-checked="true"] b { color: var(--text); }
+
+.es-rot-rand { border-color: var(--warn); color: var(--warn); }
+.es-rot { background: var(--warn); border-color: var(--warn); color: #FFFFFF; box-shadow: none; }
+.es-warnung { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; padding: 12px; border-radius: 12px;
+  background: var(--gold-weich); border: 1px solid var(--gold); }
+.es-warnung svg { width: 24px; height: 24px; flex: none; color: var(--text); }
+.es-warnung p { margin: 0; font-size: 14px; color: var(--text); }
+.es-warnung.stark { background: var(--warn-weich); border-color: var(--warn); }
+.es-warnung.stark svg { color: var(--warn); }
+.es-warnung.stark p { color: var(--text); }
+.es-knoepfe { display: flex; flex-wrap: wrap; gap: 10px; }
+.es-knoepfe .knopf, .es-reset > .knopf { white-space: normal; text-align: center; }
+
+.es-info p { margin: 0 0 10px; font-size: 14px; color: var(--text-2); }
+.es-info a { color: var(--akzent-text); text-decoration: underline; text-underline-offset: 2px; overflow-wrap: anywhere;
+  /* Tippflaeche >= 44 px: Polster nur fuer den Finger, die Zeilenhoehe bleibt (Polster an inline-Elementen zaehlt nicht zur Zeile) */
+  padding-block: 13px; }
+.es-lizenzen { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
+.es-lizenzen li { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 12px; background: var(--flaeche-2); border: 1px solid var(--linie); }
