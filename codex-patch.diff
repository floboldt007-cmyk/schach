@@ -0,0 +1,61 @@
+name: Tests
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  chromium:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - name: Playwright installieren
+        run: |
+          npm install --no-save playwright
+          npx playwright install --with-deps chromium webkit
+      - name: Schnelle Tests bei Push
+        if: github.event_name == 'push'
+        run: |
+          mkdir -p artifacts/screenshots
+          set -o pipefail
+          BILDER=artifacts/screenshots node tests/alle.mjs --schnell --laut 2>&1 | tee artifacts/chromium.log
+      - name: Vollständige Tests bei Pull Requests
+        if: github.event_name == 'pull_request'
+        run: |
+          mkdir -p artifacts/screenshots
+          set -o pipefail
+          BILDER=artifacts/screenshots node tests/alle.mjs --laut 2>&1 | tee artifacts/chromium.log
+      - name: Fehlerartefakte hochladen
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: chromium-fehler
+          path: artifacts/
+          if-no-files-found: ignore
+
+  webkit:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - name: Playwright installieren
+        run: |
+          npm install --no-save playwright
+          npx playwright install --with-deps chromium webkit
+      - name: Browser-Suiten mit WebKit
+        run: |
+          mkdir -p artifacts/screenshots
+          set -o pipefail
+          BROWSER=webkit BILDER=artifacts/screenshots node tests/alle.mjs --nur=storage,board,screens,e2e --laut 2>&1 | tee artifacts/webkit.log
+      - name: Fehlerartefakte hochladen
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: webkit-fehler
+          path: artifacts/
+          if-no-files-found: ignore
