+.vl-dialog-knoepfe { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.vl-rot { background: var(--warn); border-color: var(--warn); color: #FFFFFF; box-shadow: none; }
+@keyframes vl-ein { from { opacity: 0; } }
