+
+.es-bretter { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
+.es-brett { display: flex; flex-direction: column; align-items: center; gap: 8px; min-height: 44px; padding: 10px 10px 8px; border-radius: 16px; cursor: pointer;
+  background: var(--flaeche-2); border: 1.5px solid var(--linie); color: inherit; font: inherit; }
+.es-brett[aria-checked="true"] { border-color: var(--text); background: var(--flaeche); box-shadow: inset 0 0 0 1px var(--text); }
+.es-mini { display: grid; grid-template-columns: repeat(4, 1fr); width: 100%; max-width: 136px; aspect-ratio: 1; border-radius: 10px; overflow: hidden;
+  box-shadow: var(--s2); }
+.es-mini i { position: relative; display: block; }
+.es-mini i.h { background: var(--feld-hell); }
+.es-mini i.d { background: var(--feld-dunkel); }
