+// Gewicht einer Partie gegen einen Gegner der Wertung gegnerElo, wenn man selbst etwa staerke hat
+export function gegnerGewicht(gegnerElo, staerke, modell = STAERKE_MODELL) {
+  if (!Number.isFinite(gegnerElo) || !Number.isFinite(staerke)) return 1;
