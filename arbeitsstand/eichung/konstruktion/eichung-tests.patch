@@ -0,0 +1,160 @@
+// Tests fuer die menschliche Zugwahl in js/bots.js (Eichung Oktober 2026), ohne Browser und ohne Stockfish:
+// eine Fake-Engine liefert feste Bewertungen. Ergaenzt tests/engine-bots.test.mjs (echte Engine im Browser).
+//   node tests/bots-mensch.test.mjs
+import { Chess } from '../vendor/chess/chess.js';
+import {
+  BOTS, botZug, menschenReize, naturMerkmale, NATUR, NATUR_MERKMALE, phaseVon, verlusteAusAnalyse, STIL_FENSTER_PP,
+  staerkeFuerElo,
+} from '../js/bots.js';
+
+const ergebnisse = [];
+function pruefe(name, ok, detail = '') {
+  ergebnisse.push({ name, ok: !!ok });
+  console.log((ok ? 'OK     ' : 'FEHLER ') + name + (detail && !ok ? '  (' + detail + ')' : ''));
+}
+// feste Zufallsquelle
+function zufallAus(seed) {
+  let s = seed >>> 0;
+  return () => { s = (Math.imul(s, 1664525) + 1013904223) >>> 0; return s / 4294967296; };
+}
+// Fake-Engine: Materialbilanz nach dem besten Zurueckschlagen (1 Halbzug tief), alle Zuege als MultiPV
+const W = { p: 100, n: 300, b: 300, r: 500, q: 900, k: 0 };
+function material(fen) {
+  let s = 0;
+  for (const c of fen.split(' ')[0]) { const t = c.toLowerCase(); if (W[t] != null) s += c === t ? -W[t] : W[t]; }
+  return s;
+}
+class FakeEngine {
+  constructor() { this.aufrufe = []; }
+  async analyse(fen, opts = {}) {
+    this.aufrufe.push(opts);
+    const c = new Chess(fen);
+    const vz = c.turn() === 'w' ? 1 : -1;
+    const lines = c.moves({ verbose: true }).map((m) => {
+      c.move(m);
+      let schlecht = Infinity;
+      for (const r of c.moves({ verbose: true })) { c.move(r); schlecht = Math.min(schlecht, vz * material(c.fen())); c.undo(); }
+      if (schlecht === Infinity) schlecht = vz * material(c.fen());
+      c.undo();
+      return { pv: [m.lan], eval: { cp: vz * schlecht, mate: null } };
+    }).sort((a, b) => vz * (b.eval.cp - a.eval.cp));
+    return { fen, bestmove: lines[0].pv[0], depth: opts.depth, lines: lines.slice(0, opts.multipv || 1) };
+  }
+}
+
+// ---------- Aufbau ----------
+pruefe('Stufe 1 bis 9 nutzen die menschliche Zugwahl (staerke.mensch)', BOTS.slice(0, 9).every((b) => b.staerke.mensch && Number.isFinite(b.staerke.mensch.sorgfalt)));
+pruefe('Keine Spontanzuege mehr in der Leiter (patzer/rauschen nicht gesetzt)', BOTS.slice(0, 9).every((b) => !b.staerke.patzer && !b.staerke.rauschen));
+pruefe('Stufe 10 bleibt volle Engine', BOTS[9].staerke.voll === true);
+pruefe('Natur-Gewichte vollstaendig und endlich', NATUR_MERKMALE.every((k) => Number.isFinite(NATUR.basis[k]) && Number.isFinite(NATUR.steigung[k])));
+// Eichung Oktober 2026: sorgfalt, biss und Kandidaten sind je Stufe gemeinsam geeicht (steigen nicht einzeln mit der
+// Stufe); eloJeLn = lokale Steigung der Eichkurve fuer staerkeFuerElo
+pruefe('Eichwerte Stufe 2 bis 9 gueltig (sorgfalt > 0, biss 0 bis 1,5, Kandidaten 0 bis 8, eloJeLn > 0)', BOTS.slice(1, 9).every((b) => {
+  const m = b.staerke.mensch;
+  return m.sorgfalt > 0 && m.biss > 0 && m.biss <= 1.5 && Number.isInteger(m.kandidaten) && m.kandidaten >= 0 && m.kandidaten <= 8 && m.eloJeLn > 0;
+}));
+pruefe('Kandidaten: schwache Stufen betrachten mehr Zuege (Benno alle, Hilde und Kalle 8), starke 3', BOTS[0].staerke.mensch.kandidaten === 0
+  && BOTS[1].staerke.mensch.kandidaten === 8 && BOTS[2].staerke.mensch.kandidaten === 8 && BOTS.slice(6, 9).every((b) => b.staerke.mensch.kandidaten === 3));
+pruefe('Rechentiefe steigt nicht ab (Stufe 1 bis 9)', BOTS.slice(0, 9).every((b, i, a) => i === 0 || b.staerke.tiefe >= a[i - 1].staerke.tiefe));
+
+// ---------- staerkeFuerElo (Boss "etwa deine Wertung") ----------
+{
+  const s1300 = staerkeFuerElo(1300);
+  const rudi = BOTS.find((b) => b.id === 'rudi').staerke.mensch.sorgfalt;
+  const turm = BOTS.find((b) => b.id === 'turm').staerke.mensch.sorgfalt;
+  pruefe('staerkeFuerElo(1300): Profil von Rudi (naeher), nur sorgfalt entlang seiner Eichkurve hoeher',
+    s1300.elo === 1300 && s1300.botId === 'rudi' && s1300.staerke.mensch.elo === 1200 && s1300.staerke.mensch.sorgfalt > rudi
+    && Math.abs(s1300.staerke.mensch.sorgfalt - rudi * Math.exp(100 / BOTS.find((b) => b.id === 'rudi').staerke.mensch.eloJeLn)) < 1e-9
+    && s1300.staerke.mensch.biss === BOTS.find((b) => b.id === 'rudi').staerke.mensch.biss && turm > 0
+    && JSON.stringify(s1300.staerke.vorlieben) === JSON.stringify(BOTS.find((b) => b.id === 'rudi').staerke.vorlieben), JSON.stringify(s1300.staerke.mensch));
+  const reihe = [1000, 1050, 1100].map((e) => staerkeFuerElo(e).staerke.mensch.sorgfalt);
+  pruefe('staerkeFuerElo: innerhalb eines Nachbarn steigt sorgfalt mit der Elo', reihe[0] < reihe[1] && reihe[1] < reihe[2], reihe);
+  pruefe('staerkeFuerElo: Leiter-Elo gibt den Leiter-Bot, ausserhalb 500 bis 2100 der naechstliegende (wie vor der Eichung)', staerkeFuerElo(1400).botId === 'turm' && staerkeFuerElo(3000).botId === 'stockfisch' && staerkeFuerElo(2400).botId === 'greta' && staerkeFuerElo(100).botId === 'benno' && staerkeFuerElo(450).botId === 'hilde' && staerkeFuerElo(NaN) === null);
+  pruefe('staerkeFuerElo: Kopie, Leiter bleibt unveraendert', (() => { const x = staerkeFuerElo(1600); x.staerke.mensch.sorgfalt = 99; return BOTS.find((b) => b.id === 'delia').staerke.mensch.sorgfalt !== 99; })());
+}
+
+// ---------- Phasen und Merkmale ----------
+pruefe('phaseVon: Startstellung = eroeffnung', phaseVon(new Chess().fen()) === 'eroeffnung');
+pruefe('phaseVon: Turmendspiel = endspiel', phaseVon('8/5pk1/6p1/7p/3R3P/6P1/r4PK1/8 w - - 0 40') === 'endspiel');
+pruefe('phaseVon: Halbzug 30+ = mittelspiel', phaseVon('r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 16') === 'mittelspiel');
+const DAME = 'rnb1kbnr/pppp1ppp/8/4p3/4P2q/5N2/PPPP1PPP/RNBQKB1R w KQkq - 2 3';   // Sxh4 nimmt die freie Dame
+{
+  const c = new Chess(DAME);
+  const z = c.moves({ verbose: true }).find((m) => m.lan === 'f3h4');
+  const f = naturMerkmale(c, z, { farbe: 'w', vollzug: 3, phase: 'eroeffnung', vorigerZug: 'd8h4' });
+  const i = (k) => f[NATUR_MERKMALE.indexOf(k)];
+  pruefe('Merkmale: Sxh4 ist Schlagen, Materialgewinn, Flucht nicht', i('schlag') === 1 && i('gewinnSchlag') === 3 && i('flucht') === 0, JSON.stringify(f));
+  pruefe('Merkmale: Stellung unveraendert nach naturMerkmale', c.fen() === DAME);
+  const h = c.moves({ verbose: true }).find((m) => m.lan === 'f1a6');   // Laeufer haengt auf a6 (b7xa6)
+  const fh = naturMerkmale(c, h, { farbe: 'w', vollzug: 3, phase: 'eroeffnung' });
+  pruefe('Merkmale: La6 haengt (vom Bauern angegriffen)', fh[NATUR_MERKMALE.indexOf('haengt')] === 1 && fh[NATUR_MERKMALE.indexOf('bauernAngriff')] === 1);
+}
+{
+  const c = new Chess('4k3/8/8/3p4/4P3/8/8/4K3 w - - 0 1');
+  const z = c.moves({ verbose: true }).find((m) => m.lan === 'e4d5');
+  const f = naturMerkmale(c, z, { farbe: 'w', vollzug: 1, phase: 'endspiel', vorigerZug: 'd7d5' });
+  pruefe('Merkmale: Zurueckschlagen erkannt (vorigerZug)', f[NATUR_MERKMALE.indexOf('rueckSchlag')] === 1);
+}
+
+// ---------- Verluste und Reize ----------
+{
+  const c = new Chess(DAME);
+  const zuege = c.moves({ verbose: true });
+  const analyse = await new FakeEngine().analyse(DAME, { multipv: 256 });
+  const v = verlusteAusAnalyse(zuege, analyse, 'w');
+  pruefe('Verluste: bester Zug 0, alle Zuege bewertet, nie negativ', v.get('f3h4') === 0 && v.size === zuege.length && [...v.values()].every((x) => x >= 0));
+  const lisa = BOTS.find((b) => b.id === 'lisa');
+  const r = menschenReize(c, zuege, analyse, lisa, { farbe: 'w', vollzug: 3, fen: DAME, verboten: new Set() });
+  const kandidaten = new Set(r.map((x) => x.zug.lan));
+  pruefe('Kandidaten: Lisa betrachtet nicht alle Zuege (beste 5 + forcierende)', kandidaten.size < zuege.length && kandidaten.has('f3h4'), kandidaten.size + ' von ' + zuege.length);
+  const benno = BOTS.find((b) => b.id === 'benno');
+  const rb = menschenReize(c, zuege, analyse, benno, { farbe: 'w', vollzug: 3, fen: DAME, verboten: new Set() });
+  pruefe('Kandidaten: Benno (Anfaenger) betrachtet alle Zuege', rb.length === zuege.length);
+  const reizDame = (rr) => rr.find((x) => x.zug.lan === 'f3h4').reiz - Math.max(...rr.filter((x) => x.zug.lan !== 'f3h4').map((x) => x.reiz));
+  pruefe('Reize: die freie Dame reizt Lisa staerker als Benno', reizDame(r) > reizDame(rb));
+  const ohne = menschenReize(c, zuege, analyse, lisa, { farbe: 'w', vollzug: 3, fen: DAME, verboten: new Set(['f3h4']) });
+  pruefe('Reize: verbotene Zuege fehlen', !ohne.some((x) => x.zug.lan === 'f3h4'));
+  // Begrenzte MultiPV (Delia, Koenig, Greta): Zuege ausserhalb der Liste sind keine Kandidaten, auch nicht als Schlag-
+  // oder Schachzug (vorher "schlechtester + 5" und oft gewaehlt: die meisten groben Patzer der oberen Stufen)
+  const kurz = { ...analyse, lines: analyse.lines.slice(0, 4) };
+  const gelistet = new Set(kurz.lines.map((l) => l.pv[0]));
+  const delia = BOTS.find((b) => b.id === 'delia');
+  const rd = menschenReize(c, zuege, kurz, delia, { farbe: 'w', vollzug: 3, fen: DAME, verboten: new Set() });
+  pruefe('Kandidaten: bei begrenzter MultiPV nur bewertete Zuege', rd.length > 0 && rd.every((x) => gelistet.has(x.zug.lan)),
+    rd.map((x) => x.zug.lan).join(','));
+}
+
+// ---------- botZug ----------
+{
+  const e = new FakeEngine();
+  const anteil = async (bot, n = 60) => {
+    let t = 0;
+    for (let i = 0; i < n; i++) {
+      const r = await botZug(e, DAME, bot, { ohnePause: true, zufall: zufallAus(100 + i), vorigerZug: 'd8h4' });
+      if (r.uci === 'f3h4') t++;
+    }
+    return t / n;
+  };
+  const a = await anteil(BOTS.find((b) => b.id === 'hilde'));
+  const d = await anteil(BOTS.find((b) => b.id === 'delia'));
+  pruefe('Freie Dame: Hilde nimmt sie meistens, Delia (fast) immer', a >= 0.6 && d >= 0.95, `Hilde ${Math.round(100 * a)} %, Delia ${Math.round(100 * d)} %`);
+  const r1 = await botZug(e, DAME, BOTS[4], { ohnePause: true, zufall: zufallAus(7) });
+  const r2 = await botZug(e, DAME, BOTS[4], { ohnePause: true, zufall: zufallAus(7) });
+  pruefe('Gleicher Zufall, gleiche Analyse: gleicher Zug (pruefbare Partien)', r1.uci === r2.uci);
+  let arten = new Set();
+  for (const b of BOTS.slice(0, 9)) for (let i = 0; i < 5; i++) arten.add((await botZug(e, DAME, b, { ohnePause: true, zufall: zufallAus(i) })).art);
+  pruefe('Stufe 1 bis 9: keine Spontanzuege (art nie "patzer")', !arten.has('patzer'), [...arten].join(','));
+  const breiten = e.aufrufe.map((o) => o.multipv);
+  pruefe('Suche mit MultiPV ueber alle Zuege fuer die unteren Stufen', breiten.some((m) => m >= 20));
+  // Matt in 1: ab Stufe 4 immer
+  const MATT = '6k1/5ppp/8/8/8/8/5PPP/R5K1 w - - 0 1';
+  let immer = true;
+  for (const b of BOTS.slice(3, 9)) for (let i = 0; i < 5; i++) if ((await botZug(e, MATT, b, { ohnePause: true, zufall: zufallAus(i) })).uci !== 'a1a8') immer = false;
+  pruefe('Matt in 1 ab Stufe 4 immer gesehen', immer);
+  // Stil nur im Fenster: Vorlieben machen den Bot nicht schwaecher
+  pruefe('Stil-Fenster 3 Prozentpunkte', STIL_FENSTER_PP === 3);
+}
+
+const fehler = ergebnisse.filter((r) => !r.ok);
+console.log(`\n${ergebnisse.length - fehler.length}/${ergebnisse.length} bestanden`);
+process.exit(fehler.length ? 1 : 0);
